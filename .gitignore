# ------------------------------------------------------------

/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# NetBeans / Gradle build output
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ------------------------------------------------------------
